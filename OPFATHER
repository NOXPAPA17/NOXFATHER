-- Chat Engine Function
local function SayMessage(msg)
local TextChatService = game:GetService("TextChatService")
if TextChatService and TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
if TextChatService:FindFirstChild("ChatInputBarConfiguration") then
local channel = TextChatService.ChatInputBarConfiguration.TargetTextChannel
if channel then
channel:SendAsync(msg)
end
end
else
local remote = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
if remote then
local keys = remote:FindFirstChild("Keys")
if keys then
local sendMsg = keys:FindFirstChild("SendMessage")
if sendMsg then
sendMsg:InvokeServer(msg, "All")
end
end
end
end
end

